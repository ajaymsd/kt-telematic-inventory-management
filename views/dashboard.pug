doctype html
html
  head
    title Dashboard
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")

  body
    .container.mt-5
      .d-flex.justify-content-between.align-items-center.mb-4
        h2 Hello, #{username}!
        a.btn.btn-danger(href="/api/v1/logout") Logout

      .row
        .col-md-6
          .card.text-center.mb-3
            .card-body
              h4.card-title Your Products
              p.display-6 #{productsCount}
              a.btn.btn-primary(href="/products") View Products

        .col-md-6
          .card.text-center.mb-3
            .card-body
              h4.card-title Your Suppliers
              p.display-6 #{suppliersCount}
              a.btn.btn-primary(href="/suppliers") View Suppliers

      hr
      h3.mt-5.mb-3 Recently Created Products

      if recentProducts.length
        table.table.table-striped
          thead
            tr
              th ID
              th Name
              th SKU
              th Price
              th Created At
          tbody
            each product in recentProducts
              tr
                td= product.id
                td= product.name
                td= product.sku
                td ₹#{product.price.toFixed(2)}
                td= new Date(product.createdAt).toLocaleString()
      else
        p.text-muted No products created yet.

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
