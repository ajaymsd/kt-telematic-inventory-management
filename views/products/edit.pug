doctype html
html
  head
    title Edit Product
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")

  body
    .container.mt-5
      h1.mb-4 Edit Product

      form(method="POST", action=`/api/v1/products/${product.id}`)
        input(type="hidden", name="_method", value="PUT")

        .mb-3
          label.form-label(for="name") Product Name
          input.form-control(type="text", name="name", required, value=product.name)

        .mb-3
          label.form-label(for="sku") SKU
          input.form-control(type="text", name="sku", required, value=product.sku, readonly)

        .mb-3
          label.form-label(for="price") Price
          input.form-control(type="number", name="price", step="0.01", required, value=product.price)

        .mb-3
          label.form-label(for="quantity") Quantity
          input.form-control(type="number", name="quantity", required, value=product.quantity)

        .mb-3
          label.form-label(for="category") Category
          input.form-control(type="text", name="category", required, value=product.category)

        .mb-3
          label.form-label(for="supplierId") Supplier (Optional)
          select.form-select(name="supplierId")
            option(value="") -- Select Supplier --
            each supplier in suppliers
              if product.supplierId == supplier.id
                option(value=supplier.id selected)= supplier.name
              else
                option(value=supplier.id)= supplier.name

        button.btn.btn-primary(type="submit") Update Product

      a.btn.btn-secondary.mt-3(href="/products") Back to Product List

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
