doctype html
html
  head
    title Products List
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")

    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css")

  body
    .container.mt-5
      h1.mb-4 Products List

      if products.length
        table#productsTable.table.table-striped.table-bordered
          thead
            tr
              th ID
              th Name
              th SKU
              th Price
              th Quantity
              th Category
              th Supplier
              th Action
          tbody
            each product in products
              tr
                td= product.id
                td= product.name
                td= product.sku
                td ₹#{product.price.toFixed(2)}
                td= product.quantity
                td= product.category
                td= product.supplier ? product.supplier.name : 'N/A'
                td
                  a.btn.btn-sm.btn-warning(href=`/products/edit/${product.id}`) Edit
                  form(method="POST", action=`/api/v1/products/${product.id}`, style="display:inline-block; margin-left:5px;")
                    input(type="hidden", name="_method", value="DELETE")
                    button.btn.btn-sm.btn-danger(type="submit", onclick="return confirm('Are you sure you want to delete this product?')") Delete
      else
        p.text-muted No products available.

      a.btn.btn-primary.mt-4(href="/suppliers") View Suppliers
      a.btn.btn-success.mt-4.ms-2(href="/products/add") Add New Product
       a.btn.btn-danger.mt-4.ms-2(href="/dashboard") Go to dashboard

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script(src="https://code.jquery.com/jquery-3.6.0.min.js")
    script(src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js")
    script(src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js")

    script.
      $(document).ready(function() {
        $('#productsTable').DataTable();
      });
