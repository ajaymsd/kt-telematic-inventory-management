doctype html
html
  head
    title Edit Supplier
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")

    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")

  body
    .container.mt-5
      h1.mb-4 Edit Supplier

      form(method="POST", action=`/api/v1/suppliers/${supplier.id}`)
        input(type="hidden", name="_method", value="PUT")

        .mb-3
          label.form-label(for="name") Supplier Name
          input.form-control(type="text", name="name", required, value=supplier.name)

        .mb-3
          label.form-label(for="contact") Contact Info
          input.form-control(type="text", name="contact", required, value=supplier.contact)

        button.btn.btn-primary(type="submit") Update Supplier

      a.btn.btn-secondary.mt-3(href="/suppliers") Back to Suppliers List

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
