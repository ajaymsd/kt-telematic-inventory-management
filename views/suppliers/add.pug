doctype html
html
  head
    title Add Supplier
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")

    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css")

  body
    .container.mt-5
      h1.mb-4 Add New Supplier

      form(method="POST", action="/api/v1/suppliers")
        .mb-3
          label.form-label(for="name") Supplier Name
          input.form-control(type="text", name="name", required)

        .mb-3
          label.form-label(for="contact") Contact Info
          input.form-control(type="text", name="contact", required)

        button.btn.btn-primary(type="submit") Add Supplier

      a.btn.btn-secondary.mt-3(href="/suppliers") Back to Suppliers List

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script(src="https://cdn.jsdelivr.net/npm/toastify-js")
